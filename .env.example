# Option A : URL complète (recommandé pour Supabase / Render Pooler)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Option B : Variables séparées
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plateforme_taxi
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

JWT_SECRET=change-this-secret-in-production
JWT_TTL=86400

CORS_ORIGIN=http://localhost:5173

MAIL_FROM=no-reply@taxigo.local

# Code requis pour créer un compte admin via POST /api/auth/register
# Laisser vide pour désactiver l'inscription.
ADMIN_INVITE_CODE=

